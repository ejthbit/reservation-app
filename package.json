{
    "name": "@ejthbit/reservation-app",
    "author": {
        "name": "ejthbit"
    },
    "license": "MIT",
    "description": "eReservation library which includes most of stuff needed to manage ambulance.",
    "type": "module",
    "version": "2.1.4",
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./style.css": "./dist/style.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:dev": "vite build --mode development",
        "preview": "vite preview",
        "run:mfe": "pnpm build:dev && vite preview",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@emotion/react": "^11.11.4",
        "@emotion/styled": "^11.11.5",
        "@hookform/resolvers": "^5.2.2",
        "@mui/icons-material": "^5.15.15",
        "@mui/material": "^5.15.15",
        "@mui/x-charts": "^7.2.0",
        "@mui/x-date-pickers": "^7.27.1",
        "axios": "^1.14.0",
        "date-fns": "^2.29.3",
        "notistack": "^3.0.1",
        "react-big-calendar": "^1.19.4",
        "react-google-recaptcha": "^2.1.0",
        "react-hook-form": "^7.43.4",
        "react-router-dom": "^6.8.0",
        "react-text-mask": "^5.5.0",
        "react-to-print": "^2.14.12",
        "swr": "^2.2.5",
        "zod": "^4.3.6"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "packageManager": "pnpm@9.0.2",
    "devDependencies": {
        "@eslint/js": "9.0.0",
        "@types/node": "^20.12.7",
        "@types/react": "^18.2.79",
        "@types/react-big-calendar": "^1.15.0",
        "@types/react-dom": "^18.2.25",
        "@types/react-google-recaptcha": "^2.1.9",
        "@types/react-text-mask": "^5.4.14",
        "@typescript-eslint/eslint-plugin": "^6.10.0",
        "@typescript-eslint/parser": "^6.10.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^9.0.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "prettier": "^3.2.5",
        "typescript": "^5.6.3",
        "vite": "^5.2.9",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-eslint": "^1.8.1",
        "vite-tsconfig-paths": "^4.3.2"
    }
}
